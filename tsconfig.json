{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*", ".sandcastle/**/*"],
  "exclude": [
    "node_modules",
    ".claude",
    ".sandcastle/worktrees",
    ".sandcastle/logs",
    "**/target",
    "**/dist",
    "interface",
    "assets"
  ]
}
