{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "URI com usuário e senha",
            "patterns": [
              "/\\b[a-z][a-z0-9+.-]*:\\/\\/[^\\s:@\\/'\"`]+:(?<password>(?!\\$|<|\\{|%)[^\\s@\\/'\"`]+)@[^\\s\\/'\"`]+/i"
            ]
          },
          {
            "name": "senha em connection string chave=valor",
            "patterns": [
              "/[;&?]\\s*(?:password|pwd)\\s*=\\s*(?<password>[^;&\\s\"'$<{%][^;&\\s\"']{3,})|(?:^|[\\s\"'`])(?:password|pwd)=(?<password2>[^;&\\s\"'$<{%][^;&\\s\"']{3,});/i"
            ]
          }
        ]
      }
    }
  ]
}
