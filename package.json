{
  "name": "shorts-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "secrets": "node scripts/secrets.mjs",
    "check": "npm run secrets && npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:full": "npm run check && npm run sast && npm run e2e",
    "sast": "node -e \"console.error('SAST ainda não configurado: adicione a ferramenta aqui.'); process.exit(1)\"",
    "e2e": "node -e \"console.error('e2e ainda não configurado: adicione a suíte aqui.'); process.exit(1)\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-dom": "^5.23.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.23.1",
    "eslint-plugin-security": "^4.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.1"
  }
}
