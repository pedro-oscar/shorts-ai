{
  "name": "shorts-ai",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run secrets && npm run audit",
    "check:full": "npm run check && npm run sast && npm run e2e",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "npm run format:check:ts && npm run format:check:rs",
    "format:check:ts": "prettier --check .",
    "format:check:rs": "cargo fmt --all --check",
    "lint": "npm run lint:ts && npm run lint:rs",
    "lint:ts": "eslint --max-warnings=0 .",
    "lint:rs": "cargo clippy --workspace --all-targets --locked -- -D warnings -D unsafe_code -D clippy::undocumented_unsafe_blocks",
    "typecheck": "npm run typecheck:ts && npm run typecheck:rs",
    "typecheck:ts": "tsc --noEmit && tsc --noEmit -p interface",
    "typecheck:rs": "cargo check --workspace --all-targets --locked",
    "test": "npm run test:ts && npm run test:scripts && npm run test:rs",
    "test:ts": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:rs": "cargo test --workspace --locked",
    "secrets": "node scripts/secrets.mjs",
    "audit": "npm run audit:ts && npm run audit:rs",
    "audit:ts": "npm audit --audit-level=high",
    "audit:rs": "cargo audit",
    "sast": "node scripts/sast.mjs",
    "e2e": "node scripts/e2e.mjs",
    "tickets": "node scripts/tickets.mjs",
    "afk": "tsx .sandcastle/main.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-dom": "^5.23.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.23.1",
    "eslint-plugin-security": "^4.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  }
}
